{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": {
    "includes": ["**", "!**/node_modules", "!**/dist", "!**/.codegraph"]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2 },
